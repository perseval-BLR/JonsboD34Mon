<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>JonsboD34Mon</AssemblyName>
    <RootNamespace>JonsboD34Mon</RootNamespace>
    <Product>Jonsbo D34 Mon</Product>

    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Lean runtime: no ICU, no localized resources, no background GC thread. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every WinForms control turns a keyboard layout switch into new CultureInfo(lcid); in invariant
         mode that throws unless non-predefined cultures are allowed (they then behave as invariant). -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gen0 budget is sized from the L3 cache: ~76 MB on a 96 MB X3D part, so the few KB/s the sensor
         library allocates would pile up for an hour before the first collection. 4 MB keeps private memory
         flat; a gen0 collection of this tiny heap takes well under a millisecond. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DSEG7Classic-Bold.ttf" LogicalName="seg.ttf" />
  </ItemGroup>

</Project>
